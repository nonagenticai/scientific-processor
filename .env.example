# ==============================================================================
# Scientific Processor - Environment Variables
# ==============================================================================
# Copy to .env and adjust values for your environment.

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
SCIENTIFIC_PROCESSOR_VERSION=0.1.0
SCIENTIFIC_PROCESSOR_SERVICE_NAME=scientific-processor
ENVIRONMENT=development
ENABLE_DOCS=true
ENABLE_AUTH=false
# ⚠️ NOT a placeholder. billing_service's `canonical_tenant_id` resolves the slug
# "n8n-dev" to a REAL tenant UUID and bills it, exactly as it does the prod
# default 0195f48b-d000-7000-8000-000000000001. Anything served under this value
# has its downstream token spend booked to a real customer. Local dev only.
DEFAULT_TENANT_ID=n8n-dev

# Serve a trusted-network caller that names NO tenant as DEFAULT_TENANT_ID.
# Default (and value here): true — today's behaviour. Closing it 401s every
# in-cluster caller that has not been credentialed yet, so the flip is a separate
# gitops step, taken only once the `TENANT_FALLBACK` WARNING in auth/middleware.py
# has gone quiet in Loki. Each of those lines names a peer and a path that still
# needs a license token.
ALLOW_TRUSTED_NETWORK_DEFAULT_TENANT=true

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
SCIENTIFIC_PROCESSOR_BIND_HOST=0.0.0.0
SCIENTIFIC_PROCESSOR_BIND_PORT=8808
SCIENTIFIC_PROCESSOR_RELOAD=true
SCIENTIFIC_PROCESSOR_DOCS_URL=/docs
SCIENTIFIC_PROCESSOR_REDOC_URL=/redoc
SCIENTIFIC_PROCESSOR_OPENAPI_URL=/openapi.json

# ------------------------------------------------------------------------------
# Upstream Services
# ------------------------------------------------------------------------------
SCIENTIFIC_PROCESSOR_GRAPH_ADAPTER_URL=http://localhost:8804
SCIENTIFIC_PROCESSOR_PYTORCH_BACKEND_URL=http://localhost:9100
SCIENTIFIC_PROCESSOR_INFERENCE_ROUTER_URL=http://localhost:8150
SCIENTIFIC_PROCESSOR_DISCOVERY_ENGINE_URL=http://localhost:8807

# ------------------------------------------------------------------------------
# MinIO (Artifact Storage)
# ------------------------------------------------------------------------------
SCIENTIFIC_PROCESSOR_MINIO_ENDPOINT=localhost:9000
SCIENTIFIC_PROCESSOR_MINIO_ACCESS_KEY=hp1admin
SCIENTIFIC_PROCESSOR_MINIO_SECRET_KEY=
SCIENTIFIC_PROCESSOR_MINIO_BUCKET=scientific-processor

# ------------------------------------------------------------------------------
# Request Limits
# ------------------------------------------------------------------------------
SCIENTIFIC_PROCESSOR_REQUEST_TIMEOUT=300.0
SCIENTIFIC_PROCESSOR_SUBGRAPH_MAX_HOPS=3
SCIENTIFIC_PROCESSOR_SUBGRAPH_MAX_NODES=5000

# ------------------------------------------------------------------------------
# Sandbox Limits
# ------------------------------------------------------------------------------
SCIENTIFIC_PROCESSOR_SANDBOX_TIMEOUT=120
SCIENTIFIC_PROCESSOR_SANDBOX_MEMORY_LIMIT=512Mi
SCIENTIFIC_PROCESSOR_SANDBOX_CPU_LIMIT=500m

# ------------------------------------------------------------------------------
# Integrity Score Weights
# ------------------------------------------------------------------------------
SCIENTIFIC_PROCESSOR_WEIGHT_CITATION=0.25
SCIENTIFIC_PROCESSOR_WEIGHT_CROSSREF=0.20
SCIENTIFIC_PROCESSOR_WEIGHT_COMMUNITY=0.15
SCIENTIFIC_PROCESSOR_WEIGHT_AUTHORITY=0.25
SCIENTIFIC_PROCESSOR_WEIGHT_CONTRADICTION=0.15

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
OTEL_SDK_DISABLED=true
OTLP_TRACES_ENDPOINT=http://grafana-agent:4318/v1/traces
OTEL_SERVICE_NAME=scientific-processor
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:8921,http://localhost:3000,http://127.0.0.1:3000
